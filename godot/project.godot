; Godot 4 project for the orbital mechanics simulator.
; Compatibility renderer is selected so the project runs on Chromebook
; (Crostini / llvmpipe) and mobile GPUs without requiring Vulkan.

config_version=5

[application]

config/name="Orbit Game"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

; Persistent pre-game player choices (selected stage, per-unit weapon
; loadout, per-unit initial orbit). Lives on /root so it survives the
; menu->stage scene transition. Read by SpawnDirector at start.
PlayerLoadout="*res://scripts/player_loadout.gd"

[debug]

; Promote "inferring type from Variant" to an error. The default is a
; warning, but this class of bug (typed-array pop_back returns Variant
; in 4.3) is silent until CI runs on a stricter setup. Fail at parse.
gdscript/warnings/inference_on_variant=2

[display]

window/size/viewport_width=1200
window/size/viewport_height=1000
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)]
