text = "[font_size=12][color=gray]Controls:
WASD - Move camera
Mouse - Look around
Arrows - Thrust (pro/retro/lateral)
PgUp/PgDn - Thrust (normal)
Q/E - Speed up/down time
Tab - Select next satellite
N - Add satellite
R - Remove satellite
B - Spawn 3 enemy satellites
M - Spawn meteorite cluster
V - Toggle LOS lines
K - Cycle map / wave radar / off
P - Toggle planning mode
T/G - Advance/retard plan time
C - Toggle fire control
Shift - Show range circle
Shift+Up/Dn - Adjust engage range
Esc - Release mouse[/color][/font_size]"

